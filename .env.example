# Copy this file to .env.local; ./novelka loads it automatically.
OPENROUTER_API_KEY=
NOVELKA_DB_URL=jdbc:postgresql://localhost:5432/novelka
NOVELKA_DB_USER=novelka
NOVELKA_DB_PASSWORD=novelka
NOVELKA_MODEL=openai/gpt-4o-mini
NOVELKA_SEGMENT_CHARS=1500
# Target estimate for the whole pipeline, per 5000 source tokens (not provider pricing).
NOVELKA_TARGET_USD_PER_5000=0.10
# Optional per-stage models and prices per million tokens:
# NOVELKA_PROOFREAD_MODEL=provider/model
# NOVELKA_PROOFREAD_INPUT_USD_M=0.15
# NOVELKA_PROOFREAD_OUTPUT_USD_M=0.60
