#!/bin/sh
set -eu
NOVELKA_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
NOVELKA_BIN="$NOVELKA_ROOT/cli/build/install/novelka/bin/novelka"

NOVELKA_ENV=${NOVELKA_ENV_FILE:-"$NOVELKA_ROOT/.env.local"}
if [ -f "$NOVELKA_ENV" ]; then
  set -a
  . "$NOVELKA_ENV"
  set +a
fi

NOVELKA_BUILD=0
if [ ! -x "$NOVELKA_BIN" ]; then
  NOVELKA_BUILD=1
elif find "$NOVELKA_ROOT/cli/src/main" "$NOVELKA_ROOT/core/src/main" -type f -newer "$NOVELKA_BIN" -print -quit | grep -q .; then
  NOVELKA_BUILD=1
elif [ "$NOVELKA_ROOT/build.gradle" -nt "$NOVELKA_BIN" ] || [ "$NOVELKA_ROOT/settings.gradle" -nt "$NOVELKA_BIN" ]; then
  NOVELKA_BUILD=1
elif [ "$NOVELKA_ROOT/cli/build.gradle" -nt "$NOVELKA_BIN" ] || [ "$NOVELKA_ROOT/core/build.gradle" -nt "$NOVELKA_BIN" ]; then
  NOVELKA_BUILD=1
fi

if [ "$NOVELKA_BUILD" -eq 1 ]; then
  "$NOVELKA_ROOT/gradlew" -q :cli:installDist
fi
exec "$NOVELKA_BIN" "$@"
