#!/bin/sh
set -eu
NOVELKA_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
NOVELKA_BIN="$NOVELKA_ROOT/cli/build/install/novelka/bin/novelka"

NOVELKA_ENV=${NOVELKA_ENV_FILE:-"$NOVELKA_ROOT/.env.local"}
case "$NOVELKA_ENV" in
    /*) ;;
    *) NOVELKA_ENV="$PWD/$NOVELKA_ENV" ;;
esac
if [ -n "${NOVELKA_ENV_FILE:-}" ] && [ ! -f "$NOVELKA_ENV" ]; then
    echo "Environment file not found: $NOVELKA_ENV" >&2
    exit 1
fi
if [ -f "$NOVELKA_ENV" ]; then
    set -a
    . "$NOVELKA_ENV"
    set +a
fi

# Gradle tracks deleted files, resources and build settings as well as changed sources.
# Keep the caller's directory for --file/--output, and build output out of CLI stdout.
"$NOVELKA_ROOT/gradlew" -p "$NOVELKA_ROOT" -q :cli:installDist >&2
exec "$NOVELKA_BIN" "$@"
