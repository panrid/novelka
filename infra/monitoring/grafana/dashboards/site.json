        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"app\", uri!=\"/api/events\"}[10m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
