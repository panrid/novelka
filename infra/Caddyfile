novelka.in.ua {
    encode gzip
    # Live updates (/api/events) must reach the browser at once, not in buffered chunks.
    # During a deploy «app» is two copies; the one going away refuses connections, and the
    # request is tried again on the other instead of failing.
    reverse_proxy app:8080 {
        flush_interval -1
        lb_try_duration 15s
        lb_try_interval 250ms
    }
}

# The old address and www lead for good to the same page on the site, path and query kept:
# bookmarks, links in Telegram and in Google keep working.
www.novelka.in.ua, novelka.panrid.space {
    redir https://novelka.in.ua{uri} permanent
}

# Test environment beside production: noindex, live updates without buffering.
dev.novelka.in.ua {
    header X-Robots-Tag "noindex, nofollow"
    encode gzip
    reverse_proxy dev-app:8080 {
        flush_interval -1
    }
}
